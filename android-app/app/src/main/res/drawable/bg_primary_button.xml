<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/blue_pressed" /><corners android:radius="16dp" /><padding android:left="20dp" android:top="15dp" android:right="20dp" android:bottom="15dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/blue" /><corners android:radius="16dp" /><padding android:left="20dp" android:top="15dp" android:right="20dp" android:bottom="15dp" /></shape>
    </item>
</selector>
